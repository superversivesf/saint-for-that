---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../lib/taxonomy';
---
<BaseLayout title="Browse by need">
  <div class="mx-auto max-w-screen-sm px-4 pb-24 pt-4 sm:max-w-2xl lg:max-w-5xl lg:px-8">
    <h1 class="font-serif text-3xl text-balance">Browse by need</h1>
    <ul class="mt-6 space-y-3">
      {CATEGORIES.map((c) => (
        <li>
          <a href={`/categories/${c.id}/`}
             class="block rounded-2xl border border-line bg-white p-4 focus-visible:ring-2 focus-visible:ring-brand">
            <h2 class="font-serif text-lg text-brand">{c.label}</h2>
            <p class="mt-1 text-sm text-ink-soft">{c.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
