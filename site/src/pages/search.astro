---
import BaseLayout from '../layouts/BaseLayout.astro';
const q = Astro.url.searchParams.get('q') ?? '';
---
<BaseLayout title="Search saints">
  <div class="mx-auto max-w-2xl px-4 pb-24 pt-4">
    <div class="sticky top-14 z-10 -mx-4 bg-parchment/90 px-4 py-3 backdrop-blur">
      <input id="pagefind-search" type="search" inputmode="search" autofocus value={q}
             placeholder="What do you need a saint for?"
             aria-label="Search saints and patronages"
             class="h-12 w-full rounded-full border border-line bg-white px-4 text-base focus-visible:ring-2 focus-visible:ring-brand" />
    </div>
    <div id="pagefind-results" class="mt-4" aria-live="polite"></div>
  </div>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      const query = params.get('q') ?? '';
      const input = document.getElementById('pagefind-search');
      if (query && input) input.value = query;
      const ui = new PagefindUI({
        element: '#pagefind-results',
        input: '#pagefind-search',
        showImages: true,
        excerptLength: 12,
        openFilters: ['category'],
      });
      if (query) ui.triggerSearch(query);

      const resultsContainer = document.getElementById('pagefind-results');
      if (resultsContainer) {
        const hintId = 'no-results-hint';
        const observer = new MutationObserver(() => {
          const existing = document.getElementById(hintId);
          const hasNoResults = resultsContainer.querySelectorAll('.pagefind-ui__result').length === 0 &&
            resultsContainer.textContent && resultsContainer.textContent.trim().length > 0;
          if (hasNoResults && !existing) {
            const hint = document.createElement('div');
            hint.id = hintId;
            hint.className = 'mt-4 rounded-2xl border border-line bg-parchment-deep p-4 text-sm text-ink-soft';
            hint.innerHTML = 'Try a synonym — e.g. <strong>lost wallet</strong> for lost items, or <a href="/" class="text-gold underline">browse categories</a>.';
            resultsContainer.appendChild(hint);
          } else if (!hasNoResults && existing) {
            existing.remove();
          }
        });
        observer.observe(resultsContainer, { childList: true, subtree: true, characterData: true });
      }
    });
  </script>
</BaseLayout>
