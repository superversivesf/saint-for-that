---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SaintCard from '../components/SaintCard.astro';
import { CATEGORIES } from '../lib/taxonomy';

const saints = await getCollection('saints');
const featured = saints.filter((s) => s.data.featured && !s.data.draft);
---
<BaseLayout title="What do you need a saint for?">
  <div class="mx-auto max-w-screen-sm px-4 pb-24 pt-4 sm:max-w-2xl lg:max-w-5xl lg:px-8">
    <h1 class="font-serif text-3xl leading-tight text-balance sm:text-4xl">What do you need a saint for?</h1>

    <form action="/search" method="get" class="sticky top-14 z-10 -mx-4 mt-4 bg-parchment/90 px-4 py-3 backdrop-blur sm:-mx-8 sm:px-8" role="search">
      <label class="sr-only" for="hero-q">Search needs, names…</label>
      <input id="hero-q" name="q" type="search" inputmode="search"
             placeholder="Search needs, names…"
             class="h-12 w-full rounded-full border border-line bg-white pl-4 pr-4 text-base shadow-sm focus-visible:ring-2 focus-visible:ring-brand" />
    </form>

    <section class="mt-6">
      <h2 class="text-lg font-semibold">Browse by need</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {CATEGORIES.map((c) => (
          <li>
            <a href={`/categories/${c.id}/`}
               class="tap-target inline-flex h-10 items-center rounded-full border border-line bg-white px-4 text-sm font-medium text-brand active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-brand">
              {c.label}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="text-lg font-semibold">Featured saints</h2>
      <div class="relative mt-3">
        <ul id="feat-track" class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 [scrollbar-width:none]">
          {featured.map((s) => (
            <li class="w-72 flex-none snap-start sm:w-80">
              <SaintCard saint={s.data} variant="featured" />
            </li>
          ))}
        </ul>
        <button id="feat-prev" type="button" aria-label="Previous saints"
                class="absolute left-0 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-line bg-parchment/90 text-brand shadow-sm backdrop-blur hover:bg-white focus-visible:ring-2 focus-visible:ring-brand sm:flex">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button id="feat-next" type="button" aria-label="Next saints"
                class="absolute right-0 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-line bg-parchment/90 text-brand shadow-sm backdrop-blur hover:bg-white focus-visible:ring-2 focus-visible:ring-brand sm:flex">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    </section>
  </div>

  <script is:inline>
    const track = document.getElementById('feat-track');
    const prev = document.getElementById('feat-prev');
    const next = document.getElementById('feat-next');
    if (track && prev && next) {
      const step = () => track.querySelector('li')?.offsetWidth ?? 288;
      prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
      next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    }
  </script>
</BaseLayout>
